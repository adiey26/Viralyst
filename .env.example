# Copy this file to .env and fill in your keys. Never share or commit .env.

# Needed for real accounts. Get it from https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Needed for the "why it works" analysis. Get it from https://platform.claude.com/settings/keys
# Without it you still get all the numbers, just no written analysis.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# PORT=4173
# POSTS_PER_ACCOUNT=60
# COMMENTS_PER_POST=25
# Adds public share counts to Reels. Needs a paid Apify plan.
# INCLUDE_SHARES=false
# Hard limit in US dollars on any single Apify scraper run
# APIFY_MAX_USD_PER_RUN=1
# Adds spoken-word transcripts to the AI analysis. Charged per minute of audio by Apify.
# INCLUDE_TRANSCRIPTS=false
