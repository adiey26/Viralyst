{
  "name": "insta-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compare two public Instagram accounts and explain what is working and why.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
